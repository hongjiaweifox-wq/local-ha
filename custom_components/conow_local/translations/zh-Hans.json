      "user": {
        "title": "连接方式",
        "description": "选择连接设备的方式：RS-485 串口、通过 485 转以太网适配器的 Modbus TCP，或直连一体机自身的 Modbus TCP。",
        "data": {
          "modbus_mode": "连接方式"
        }
      },
      "rtu": {
        "title": "Modbus RTU（串口）",
        "data": {
          "device_name": "设备名称",
          "modbus_port": "串口",
          "modbus_slave": "从站地址",
          "modbus_baudrate": "波特率"
        },
        "description": "列表会显示 Home Assistant 主机上检测到的串口，可直接选择，也可手动输入路径（如 `/dev/ttyUSB0`）。默认 **38400 8N1**、从站 **0xA0**。请先在 Conow App 中开启 **启用外部控制 / ModBus RTU**。"
      },
      "tcp": {
        "title": "Modbus TCP（以太网适配器）",
        "data": {
          "device_name": "设备名称",
          "modbus_host": "主机 / IP 地址",
          "modbus_tcp_port": "TCP 端口",
          "modbus_slave": "从站地址"
        },
        "description": "连接你的 485 转以太网适配器（默认 TCP 端口 **502**，从站 **0xA0**）。适配器会把 Modbus TCP 转换为 RTU，设备端无需任何改动。"
      },
      "tcp_direct": {
        "title": "Modbus TCP（直连一体机）",
        "data": {
          "device_name": "设备名称",
          "modbus_host": "主机 / IP 地址",
          "modbus_tcp_port": "TCP 端口",
          "modbus_slave": "从站地址",
          "tcp_verify_code": "验证码"
        },
        "description": "连接一体机自身的网口（默认 TCP 端口 **502**，从站 **0xA0**），不经过 485 转以太网适配器。请输入一体机上显示的 **8 位十六进制验证码**，它会写入保持寄存器 **0x2701–0x2702**（9985–9986），只有设备返回校验成功才会完成连接。"
      }
    },
    "abort": {
      "already_configured": "该设备已经配置过了，请直接使用现有的 Conow Local 集成条目。",
      "already_in_progress": "该设备正在配置中，请先完成或取消当前配置对话框。"
    }
