    "step": {
      "user": {
        "title": "Verbindungsart",
        "description": "Wähle, wie das Gerät erreicht wird: RS-485 seriell, Modbus TCP über einen RS-485↔Ethernet-Adapter oder Modbus TCP direkt am All-in-One-Gerät.",
        "data": {
          "modbus_mode": "Verbindungsart"
        }
      },
      "rtu": {
        "title": "Modbus RTU (seriell)",
        "data": {
          "device_name": "Gerätename",
          "modbus_port": "Serieller Anschluss",
          "modbus_slave": "Slave-Adresse",
          "modbus_baudrate": "Baudrate"
        },
        "description": "Die Liste zeigt die am Home-Assistant-Host erkannten seriellen Schnittstellen; eine auswählen oder einen Pfad wie `/dev/ttyUSB0` eingeben. Standardmäßig **38400 8N1** mit Slave **0xA0**. Vorher **Externe Steuerung / ModBus RTU** in der Conow-App aktivieren."
      },
      "tcp": {
        "title": "Modbus TCP (Ethernet-Adapter)",
        "data": {
          "device_name": "Gerätename",
          "modbus_host": "Host / IP-Adresse",
          "modbus_tcp_port": "TCP-Port",
          "modbus_slave": "Slave-Adresse"
        },
        "description": "Verbinde dich mit deinem RS-485↔Ethernet-Adapter (TCP-Port standardmäßig **502**, Slave **0xA0**). Der Adapter wandelt Modbus TCP in RTU um — am Gerät ist nichts zu ändern."
      },
      "tcp_direct": {
        "title": "Modbus TCP (direkt am All-in-One-Gerät)",
        "data": {
          "device_name": "Gerätename",
          "modbus_host": "Host / IP-Adresse",
          "modbus_tcp_port": "TCP-Port",
          "modbus_slave": "Slave-Adresse",
          "tcp_verify_code": "Bestätigungscode"
        },
        "description": "Verbinde dich mit dem eigenen Ethernet-Anschluss des All-in-One-Geräts (TCP-Port standardmäßig **502**, Slave **0xA0**). Es wird kein RS-485↔Ethernet-Adapter verwendet. Gib den **8-stelligen Hexadezimal-Bestätigungscode** vom Gerät ein; er wird in die Holding-Register **0x2701–0x2702** (9985–9986) geschrieben, und die Verbindung wird nur bei erfolgreicher Bestätigung akzeptiert."
      }
    },
